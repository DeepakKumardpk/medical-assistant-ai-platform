# Postgres
POSTGRES_USER=medical_app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=medical_ai_platform
DATABASE_URL=postgresql+psycopg2://medical_app:changeme@postgres:5432/medical_ai_platform

# Auth
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Ollama (added from milestone 4 onward)
# llama3.2:3b balances speed/quality on the CPU-only deploy VM; llama3.1:8b
# is higher quality but ~1-3 min per response on that hardware -- swap back
# if you have GPU or more CPU headroom.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional: set this to route chat/generation through Claude instead of the
# local Ollama model (RAG embeddings stay on Ollama either way). Much faster
# on CPU-only hardware, but no longer fully self-hosted/free. Leave blank to
# keep using Ollama for everything.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Uploads (added from milestone 3 onward)
UPLOAD_DIR=/data/uploads

# The real doctor-approval queue (milestone 5) is the default now; only set
# this true for quick local testing without a doctor acting on the queue.
DEV_AUTO_APPROVE=false
